FROM mcr.microsoft.com/mirror/docker/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV DOTNETCORESDK_VERSION=10.0
ENV NODE_MAJOR=20
ENV VIRTUAL_ENV=/opt/iotedgedev

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-transport-https apt-utils build-essential ca-certificates curl dialog \
        git gnupg libffi-dev libltdl-dev libssl-dev libxml2-dev libxslt1-dev \
        software-properties-common sudo wget zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    chmod a+r /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends dotnet-sdk-$DOTNETCORESDK_VERSION && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-8-jdk ca-certificates-java maven && \
    update-ca-certificates -f && \
    rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

RUN npm i -g azure-iothub yo generator-azure-iot-edge-module && \
    npm cache clean --force

RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash && \
    rm -rf /var/lib/apt/lists/*

# Switch to a non-root user because Yeoman does not work with root users
# https://github.com/Azure/iotedgedev/issues/312
RUN useradd -m iotedgedev && \
    echo 'iotedgedev ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    mkdir -p /home/iotedge && \
    chown -R iotedgedev:iotedgedev /home/iotedge

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-dev python3-venv python3-pip && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv $VIRTUAL_ENV && \
    chown -R iotedgedev:iotedgedev $VIRTUAL_ENV
ENV PATH=$VIRTUAL_ENV/bin:$PATH

WORKDIR /home/iotedge
COPY install-dev.sh /scripts/install-dev.sh
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sed -i 's/\r//' /scripts/install-dev.sh /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

USER iotedgedev
RUN pip install --no-cache-dir --upgrade pip setuptools wheel cookiecutter

RUN az extension add --name azure-iot && \
    echo 'alias python=python3' >> ~/.bashrc && \
    echo 'alias pip=pip3' >> ~/.bashrc
ENV DEBIAN_FRONTEND=teletype
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
